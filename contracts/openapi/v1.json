  "components": {
    "schemas": {
      "Body_upload_filing_api_v1_filings_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "stock_code": {
            "type": "string",
            "title": "Stock Code"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "title": "Period Start"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "title": "Period End"
          },
          "report_type": {
            "type": "string",
            "title": "Report Type"
          },
          "period_basis": {
            "type": "string",
            "title": "Period Basis"
          },
          "industry_code": {
            "type": "string",
            "title": "Industry Code",
            "default": "general_non_financial"
          },
          "source_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Uri"
          },
          "source_priority": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Source Priority",
            "default": 3
          }
        },
        "type": "object",
        "required": [
          "file",
          "stock_code",
          "company_name",
          "period_start",
          "period_end",
          "report_type",
          "period_basis"
        ],
        "title": "Body_upload_filing_api_v1_filings_post"
      },
      "ComparisonRequest": {
        "properties": {
          "company_id": {
            "type": "integer",
            "title": "Company Id"
          },
          "metric_code": {
            "type": "string",
            "title": "Metric Code"
          },
          "peer_filing_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Peer Filing Ids"
          },
          "peer_universe_version": {
            "type": "string",
            "title": "Peer Universe Version"
          },
          "coverage": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
