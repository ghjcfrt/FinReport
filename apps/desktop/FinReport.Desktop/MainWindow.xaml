<Window x:Class="FinReport.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FinReport - 可追溯财报分析" Height="880" Width="1440" MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="SourceLabelTemplate">
            <Grid ToolTip="{Binding LayoutDetail}">
                <TextBlock Text="{Binding RawLabel}" Margin="{Binding RawMargin}" FontSize="{Binding FontSize}" TextWrapping="Wrap" Visibility="{Binding PlainVisibility}"/>
                <Grid Visibility="{Binding GeometryVisibility}">
                    <TextBlock Text="{Binding Prefix}" Margin="{Binding PrefixMargin}" FontSize="{Binding FontSize}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Body}" Margin="{Binding BodyMargin}" FontSize="{Binding FontSize}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyBrush}"><Grid Margin="24,28,20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="FinReport" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Margin="0,6,0,0" Text="可追溯财报分析" FontSize="12" Foreground="#B7C7E2"/></StackPanel>
            <Border Grid.Row="1" Margin="0,32,0,20" Padding="12" Background="#243B61" CornerRadius="6"><StackPanel><TextBlock Text="当前工作流" FontSize="11" Foreground="#B7C7E2"/><TextBlock Margin="0,4,0,0" Text="新建财报分析" FontWeight="SemiBold" Foreground="White"/></StackPanel></Border>
            <StackPanel Grid.Row="2"><TextBlock Text="处理步骤" FontSize="11" FontWeight="SemiBold" Foreground="#9CB0D0" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="22" Height="22" Fill="#3B82F6"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" Text="1"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="添加财报" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="选择 PDF 与发行人" FontSize="11" Foreground="#B7C7E2"/></StackPanel></Grid>
                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="22" Height="22" Fill="#36557E"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D9E6FA" FontSize="11" Text="2"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="解析与校验" Foreground="#D9E6FA" FontWeight="SemiBold"/><TextBlock Text="提取候选事实与证据" FontSize="11" Foreground="#9CB0D0"/></StackPanel></Grid>
                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="22" Height="22" Fill="#36557E"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D9E6FA" FontSize="11" Text="3"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="人工复核" Foreground="#D9E6FA" FontWeight="SemiBold"/><TextBlock Text="确认事实、口径与来源" FontSize="11" Foreground="#9CB0D0"/></StackPanel></Grid>
                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="22" Height="22" Fill="#36557E"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D9E6FA" FontSize="11" Text="4"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="指标与 AI 分析" Foreground="#D9E6FA" FontWeight="SemiBold"/><TextBlock Text="严格计算后生成结论" FontSize="11" Foreground="#9CB0D0"/></StackPanel></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="22" Height="22" Fill="#36557E"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D9E6FA" FontSize="11" Text="5"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="报告与复现" Foreground="#D9E6FA" FontWeight="SemiBold"/><TextBlock Text="导出结构化 HTML / PDF" FontSize="11" Foreground="#9CB0D0"/></StackPanel></Grid>
            </StackPanel><TextBlock Grid.Row="3" Text="仅供研究与教学&#x0a;不构成投资建议" FontSize="11" Foreground="#9CB0D0" LineHeight="18"/></Grid></Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="40,32,40,36" MaxWidth="1160"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="财报研究工作台" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Margin="0,8,0,0" Text="从原始披露到结构化指标、证据索引和可复现分析报告，一条链路完成现场演示。" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                <Border Margin="0,16,0,0" Padding="14" Background="#EEF4FF" BorderBrush="#D5E2FB" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="01 受控输入" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/><TextBlock Margin="0,4,0,0" Text="原始 PDF 与发行人信息" FontSize="11" Foreground="{StaticResource InkBrush}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="02 证据定位" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/><TextBlock Margin="0,4,0,0" Text="页码、表名、来源与置信度" FontSize="11" Foreground="{StaticResource InkBrush}"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0"><TextBlock Text="03 严格计算" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/><TextBlock Margin="0,4,0,0" Text="校验通过后才进入指标与分析" FontSize="11" Foreground="{StaticResource InkBrush}"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock Text="04 可复现交付" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/><TextBlock Margin="0,4,0,0" Text="日志、版本、指纹与结构化报告" FontSize="11" Foreground="{StaticResource InkBrush}"/></StackPanel>
                    </Grid>
                </Border></StackPanel><Border Grid.Column="1" Padding="12,7" Background="#E8F7F1" CornerRadius="5" VerticalAlignment="Top"><TextBlock Text="●  本地 API 工作模式" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"/></Border></Grid>
            <Grid Grid.Row="1" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="1. 添加财报"/>
                            <TextBlock Margin="0,5,0,0" Text="选择完整年度报告 PDF，并填写发行人和报告年度。" Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,20,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="财报文件"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="选择 PDF 文件" Command="{Binding SelectFileCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="16,24,0,0" Padding="12,9" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="{Binding SelectedFilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFilePath}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="股票代码"/>
                                <TextBox Style="{StaticResource InputField}" Text="{Binding StockCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：600519"/>
                                <TextBlock Style="{StaticResource FieldHint}" Text="用于标识报告所属上市公司。"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="公司名称"/>
                                <TextBox Style="{StaticResource InputField}" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：贵州茅台"/>
                                <TextBlock Style="{StaticResource FieldHint}" Text="请填写报告封面上的发行人全称。"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="报告年度" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Width="100" Text="{Binding ReportYear, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </StackPanel>
                            <Button Grid.Column="3" Margin="20,20,0,0" Style="{StaticResource PrimaryButton}" Content="上传并解析" Command="{Binding UploadCommand}" IsEnabled="{Binding CanSubmit}" VerticalAlignment="Top"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="处理进度"/>
                        <TextBlock Grid.Row="1" Margin="0,5,0,18" Text="{Binding StatusMessage}" Style="{StaticResource FieldHint}"/>
                        <ProgressBar Grid.Row="2" Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="{StaticResource BlueBrush}" Background="#E7EDF6" BorderThickness="0"/>
                        <Grid Grid.Row="3" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="任务完成度" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Expander Grid.Row="2" Header="模型与连接设置" IsExpanded="False" Margin="0,0,0,14" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" CornerRadius="8" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="模型连接"/><TextBlock Margin="0,5,0,0" Text="分析与 OCR 使用独立连接。每个字段均会明确发送给后端设置接口。" Style="{StaticResource FieldHint}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="保存模型设置" Command="{Binding SaveModelSettingsCommand}" VerticalAlignment="Top"/></Grid><TextBlock Grid.Row="1" Margin="0,14,0,0" Text="{Binding ModelSettingsMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/><Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="结果分析模型" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="生成分析结论时调用的模型服务" Style="{StaticResource FieldHint}" Margin="0,4,0,18"/><TextBlock Style="{StaticResource FieldLabel}" Text="API 规范"/><ComboBox Style="{StaticResource InputCombo}" SelectedValue="{Binding AnalysisProvider}" SelectedValuePath="Tag"><ComboBoxItem Style="{StaticResource ComboItem}" Content="OpenAI" Tag="openai"/><ComboBoxItem Style="{StaticResource ComboItem}" Content="Anthropic" Tag="anthropic"/></ComboBox><TextBlock Style="{StaticResource FieldLabel}" Text="API Base URL" Margin="0,16,0,6"/><TextBox Style="{StaticResource InputField}" Text="{Binding AnalysisBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：https://api.example.com/v1"/><TextBlock Style="{StaticResource FieldLabel}" Text="API 密钥（可选）" Margin="0,16,0,6"/><PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="AnalysisApiKeyChanged" ToolTip="留空时保持服务端已保存的密钥"/><TextBlock Style="{StaticResource FieldHint}" Text="留空表示不改动服务端现有密钥；输入值不会回显。"/><TextBlock Style="{StaticResource FieldLabel}" Text="模型名称" Margin="0,16,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Grid.Column="0" Style="{StaticResource InputCombo}" IsEditable="True" ItemsSource="{Binding AnalysisModels}" Text="{Binding AnalysisModel, UpdateSourceTrigger=PropertyChanged}" ToolTip="可手动输入，或点击右侧按钮获取模型列表"/><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,0" Content="获取模型列表" Command="{Binding DiscoverAnalysisModelsCommand}"/></Grid><TextBlock Style="{StaticResource FieldHint}" Text="读取当前 API 的 /models 接口；成功后可直接从下拉列表选择。"/></StackPanel><Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}"/>
                <StackPanel Grid.Column="2" Margin="28,0,0,0"><TextBlock Text="OCR 模型" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="识别 PDF 图像、表格与文字时调用的模型服务" Style="{StaticResource FieldHint}" Margin="0,4,0,18"/><TextBlock Style="{StaticResource FieldLabel}" Text="API 规范"/><ComboBox Style="{StaticResource InputCombo}" SelectedValue="{Binding OcrProvider}" SelectedValuePath="Tag"><ComboBoxItem Style="{StaticResource ComboItem}" Content="OpenAI" Tag="openai"/><ComboBoxItem Style="{StaticResource ComboItem}" Content="Anthropic" Tag="anthropic"/></ComboBox><TextBlock Style="{StaticResource FieldLabel}" Text="API Base URL" Margin="0,16,0,6"/><TextBox Style="{StaticResource InputField}" Text="{Binding OcrBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：https://api.example.com/v1"/><TextBlock Style="{StaticResource FieldLabel}" Text="API 密钥（可选）" Margin="0,16,0,6"/><PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="OcrApiKeyChanged" ToolTip="留空时保持服务端已保存的密钥"/><TextBlock Style="{StaticResource FieldHint}" Text="留空表示不改动服务端现有密钥；输入值不会回显。"/><TextBlock Style="{StaticResource FieldLabel}" Text="模型名称" Margin="0,16,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Grid.Column="0" Style="{StaticResource InputCombo}" IsEditable="True" ItemsSource="{Binding OcrModels}" Text="{Binding OcrModel, UpdateSourceTrigger=PropertyChanged}" ToolTip="可手动输入，或点击右侧按钮获取模型列表"/><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,0" Content="获取模型列表" Command="{Binding DiscoverOcrModelsCommand}"/></Grid><TextBlock Style="{StaticResource FieldHint}" Text="读取当前 API 的 /models 接口；成功后可直接从下拉列表选择。"/></StackPanel>
            </Grid></Grid></Border></Expander>
            <Expander Grid.Row="3" Header="ClamAV 病毒库与扫描器" IsExpanded="True" Margin="0,0,0,14" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" CornerRadius="8" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="病毒库状态"/><TextBlock Margin="0,5,0,0" Text="ClamAV 病毒库需要联网更新；更新完成后会在服务端校验签名、执行探针并原子激活。更新失败会继续保留当前可用版本。" Style="{StaticResource FieldHint}" TextWrapping="Wrap"/><TextBlock Margin="0,12,0,0" Text="{Binding ScannerHealthMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Margin="16,0,8,0" Style="{StaticResource SecondaryButton}" Content="刷新状态" Command="{Binding RefreshScannerHealthCommand}" VerticalAlignment="Top"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="更新病毒库" Command="{Binding UpdateScannerDatabaseCommand}" IsEnabled="{Binding CanUpdateScanner}" VerticalAlignment="Top"/></Grid></Border></Expander><Expander Grid.Row="4" Header="执行审计与复现" IsExpanded="False" Margin="0,0,0,14" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" CornerRadius="8" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="执行审计与复现"/><TextBlock Margin="0,5,0,0" Text="完整记录文件访问、工具调用、严格计算、模型生成与导出；指纹可用于核验来源与重放输入。" Style="{StaticResource FieldHint}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="刷新审计记录" Command="{Binding RefreshAuditTrailCommand}"/></Grid><Border Grid.Row="1" Margin="0,18,0,16" Padding="14" Background="#F7FAFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5"><StackPanel><TextBlock Text="{Binding AuditSummary}" FontSize="12" Foreground="{StaticResource InkBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding ReproducibilitySummary}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource AuditHeader}" Text="时间"/><TextBlock Grid.Column="1" Style="{StaticResource AuditHeader}" Text="类型 / 状态"/><TextBlock Grid.Column="2" Style="{StaticResource AuditHeader}" Text="动作、工具与来源"/><TextBlock Grid.Column="3" Style="{StaticResource AuditHeader}" Text="输入指纹"/><TextBlock Grid.Column="4" Style="{StaticResource AuditHeader}" Text="输出指纹"/><TextBlock Grid.Column="5" Style="{StaticResource AuditHeader}" Text="可核验明细"/></Grid><ListView Grid.Row="1" ItemsSource="{Binding AuditEvents}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.ItemTemplate><DataTemplate><Border Padding="8,7" BorderBrush="#E7EDF6" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Style="{StaticResource AuditCell}" Text="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/><TextBlock Grid.Column="1" Style="{StaticResource AuditCell}" Text="{Binding Category}" ToolTip="{Binding Status}"/><TextBlock Grid.Column="2" Style="{StaticResource AuditCell}" Text="{Binding Action}" ToolTip="{Binding ToolName}"/><TextBlock Grid.Column="3" Style="{StaticResource AuditCell}" Text="{Binding InputHash}" ToolTip="{Binding SourceRef}" FontFamily="Cascadia Mono, Consolas"/><TextBlock Grid.Column="4" Style="{StaticResource AuditCell}" Text="{Binding OutputHash}" FontFamily="Cascadia Mono, Consolas"/><TextBlock Grid.Column="5" Style="{StaticResource AuditCell}" Text="{Binding DetailSummary}" ToolTip="{Binding DetailSummary}"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Grid></Border></Expander>
            <Grid Grid.Row="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="研究结果与交付" Style="{StaticResource SectionTitle}"/><TextBlock Margin="0,5,0,0" Text="仅当严格事实与指标准备完成后，才启动 AI 分析并生成可复现报告。" Style="{StaticResource FieldHint}"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,14,0,16"><Button Style="{StaticResource SecondaryButton}" Content="开始 AI 分析" Command="{Binding StartAnalysisCommand}" IsEnabled="{Binding CanStartAnalysis}" Margin="0,0,10,0"/><Button Style="{StaticResource SecondaryButton}" Content="重新执行" Command="{Binding RetryCommand}" Margin="0,0,10,0"/><Button Style="{StaticResource SecondaryButton}" Content="取消任务" Command="{Binding CancelCommand}" Margin="0,0,10,0"/><Button Style="{StaticResource SecondaryButton}" Content="导出 HTML" Command="{Binding ExportCommand}"/></WrapPanel><Border Grid.Row="2" Padding="16" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="处理结果（结构化数据 / 证据 / 结论）" FontSize="13" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Text="{Binding ReviewSummary}" Foreground="{StaticResource MutedBrush}"/>
<Expander Header="原表与事实核对" IsExpanded="True" Margin="0,12,0,12">
<TabControl>
<TabItem Header="原表（保留缩进）"><StackPanel Margin="12">
<TextBlock Text="保留原文科目、实际缩进、空白格及分类行。候选表仅供阅读，请对照原始 PDF；不会直接成为已核验事实。" TextWrapping="Wrap"/>
<WrapPanel Margin="0,12,0,8">
    <TextBlock Text="页码" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox Width="90" ItemsSource="{Binding OriginalTablePages}" SelectedItem="{Binding SelectedTablePage}" Margin="0,0,16,0"/>
    <TextBlock Text="表格" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox Width="300" ItemsSource="{Binding OriginalTables}" SelectedItem="{Binding SelectedOriginalTable}" DisplayMemberPath="SelectionLabel" Margin="0,0,12,0"/>
    <Button Content="刷新原表" Command="{Binding RefreshOriginalTablesCommand}" Margin="0,0,10,0"/>
    <Button Content="打开原始 PDF" Command="{Binding OpenSourcePdfCommand}"/>
</WrapPanel>
<TextBlock Text="{Binding OriginalTableSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
<TextBlock Text="{Binding SelectedOriginalTable.Metadata}" Margin="0,6,0,8" FontWeight="SemiBold" ToolTip="{Binding SelectedOriginalTable.SourceDetail}"/>
<ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CanContentScroll="False">
    <StackPanel DataContext="{Binding SelectedOriginalTable}" MinWidth="780" Grid.IsSharedSizeScope="True">
        <Grid Background="#EEF3F9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="340" SharedSizeGroup="OriginalSourceLabel"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FirstColumnHeading}" Margin="10,9" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding AdditionalColumnHeadings}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Width="150" Padding="10,9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"><TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="340" SharedSizeGroup="OriginalSourceLabel"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Padding="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <ContentControl Content="{Binding Label}" ContentTemplate="{StaticResource SourceLabelTemplate}" HorizontalContentAlignment="Stretch"/>
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding AdditionalCells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="150" Padding="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,1">
                                <TextBlock Text="{Binding Value}" ToolTip="{Binding Detail}" TextAlignment="Right" TextWrapping="Wrap" FontFamily="Consolas"/>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ScrollViewer>
</StackPanel></TabItem>
<TabItem Header="事实核对与双人复核"><StackPanel Margin="12">
<TextBlock Text="金额已统一为人民币元；请对照来源页的原数和单位。两名独立复核人分别以自己的标识逐条确认，订正金额填写元。" TextWrapping="Wrap"/>
<DataGrid Height="300" ItemsSource="{Binding Facts}" SelectedItem="{Binding SelectedFact}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10">
<DataGrid.Columns><DataGridTemplateColumn Header="原文科目" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Label}" ContentTemplate="{StaticResource SourceLabelTemplate}" HorizontalContentAlignment="Stretch" ToolTip="{Binding ConceptName}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="标准金额（元）" Binding="{Binding AmountDisplay}" Width="180"/><DataGridTextColumn Header="原文位置、列与单位" Binding="{Binding SourceDisplay}" Width="*"/><DataGridTextColumn Header="审核状态" Binding="{Binding ReviewStatus}" Width="110"/></DataGrid.Columns>
</DataGrid>
<WrapPanel><TextBlock Text="复核人标识" VerticalAlignment="Center"/><TextBox Width="140" Margin="8,0,16,0" Text="{Binding ReviewerId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="核对说明" VerticalAlignment="Center"/><TextBox Width="260" Margin="8,0,16,0" Text="{Binding ReviewReason, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="订正金额（元）" VerticalAlignment="Center"/><TextBox Width="160" Margin="8,0" Text="{Binding CorrectedAmount, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
<WrapPanel Margin="0,12,0,12"><Button Content="打开原始 PDF" Command="{Binding OpenSourcePdfCommand}" Margin="0,0,10,0"/><Button Content="确认所选事实" Command="{Binding ConfirmFactCommand}" Margin="0,0,10,0"/><Button Content="订正所选事实" Command="{Binding CorrectFactCommand}" Margin="0,0,10,0"/><Button Content="拒绝所选事实" Command="{Binding RejectFactCommand}" Margin="0,0,10,0"/><Button Content="刷新事实与校验" Command="{Binding RefreshFactsCommand}" Margin="0,0,10,0"/><Button Content="核验后计算指标" Command="{Binding CalculateMetricsCommand}"/></WrapPanel>
<TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"/>
</StackPanel></TabItem>
</TabControl></Expander>
<TextBlock Margin="0,4,0,0" Text="{Binding MetricsSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Expander Header="分析结果" Margin="0,10"><TextBox Text="{Binding AnalysisSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="400" VerticalScrollBarVisibility="Auto"/></Expander><TextBlock Margin="0,4,0,0" Text="{Binding ExportSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
        </Grid></ScrollViewer>
    </Grid>
</Window>
