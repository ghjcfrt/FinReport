# SQLite is the development default. Use a PostgreSQL 16 connection string for integration/deployment.
FINREPORT_DATABASE_URL=sqlite:///./data/finreport.db
FINREPORT_STORAGE_DIR=./data/storage
FINREPORT_MAX_UPLOAD_BYTES=52428800
FINREPORT_TASK_BACKEND=background
# Malware scanning fails closed by default. Production uses the Rust Supervisor control
# pipe. The clamscan mode is an explicit local-development fallback; mock is test-only.
FINREPORT_AV_MODE=supervisor
# Reject official ClamAV databases older than seven days (enforced by Supervisor).
FINREPORT_AV_MAX_DATABASE_AGE_SECONDS=604800
# FINREPORT_AV_MODE=clamav
# FINREPORT_AV_SCANNER_EXECUTABLE=C:\Program Files\ClamAV\clamscan.exe
FINREPORT_AV_SCAN_TIMEOUT_SECONDS=60
# FINREPORT_STORAGE_BACKEND=s3
# FINREPORT_S3_ENDPOINT_URL=http://127.0.0.1:9000
# FINREPORT_S3_BUCKET=finreport
# FINREPORT_S3_ACCESS_KEY=...
# FINREPORT_S3_SECRET_KEY=...
# FINREPORT_REDIS_URL=redis://127.0.0.1:6379/0
# Optional API boundary protection for non-local deployments.
# FINREPORT_API_KEY=change-me
# Set these only after registering approved providers. Analysis/OCR fail closed when absent.
# FINREPORT_LLM_PROVIDER=openai
# FINREPORT_LLM_BASE_URL=https://provider.example/v1
# FINREPORT_LLM_API_KEY=...
# FINREPORT_LLM_MODEL=...
# FINREPORT_LLM_TIMEOUT_SECONDS=120
# Maximum tool-action rounds in one execution; not a total token limit.
# FINREPORT_ANALYSIS_AGENT_MAX_ROUNDS=16
# Optional OpenAI-compatible gateway options; model support determines effect.
# Unset thinking/effort values send no additional request fields.
# FINREPORT_LLM_ENABLE_THINKING=true
# FINREPORT_LLM_REASONING_EFFORT=medium
# Streamed provider reasoning remains separate from final answer text in audit metadata.
# FINREPORT_LLM_STREAM=true
# Optional price-first smart routing; omit for providers without this extension.
# FINREPORT_LLM_PROVIDER_SORT=price_multiplier
# Use json_schema only when the configured provider supports strict JSON schema.
# FINREPORT_LLM_STRUCTURED_OUTPUT_MODE=json_object
# Baidu Unlimited-OCR. Local vLLM uses its OpenAI-compatible endpoint;
# the API key may be empty for a local server.
# FINREPORT_OCR_PROVIDER=baidu-unlimited-ocr
# Local installed Unlimited-OCR service: tools/local-ocr/start-unlimited-ocr.ps1.
# FINREPORT_OCR_BASE_URL=http://127.0.0.1:8765/v1
# FINREPORT_OCR_API_KEY=...
# FINREPORT_OCR_MODEL=baidu/Unlimited-OCR
# FINREPORT_OCR_PROTOCOL=openai_compatible
# FINREPORT_OCR_PROMPT=<image>document parsing.
# Official Baidu Cloud: set both API Key and Secret Key to acquire/cache an
# access token automatically. For an existing access token, put it in API_KEY
# and leave SECRET_KEY empty. These are independent of the analysis model.
# FINREPORT_OCR_PROTOCOL=baidu_cloud
# FINREPORT_OCR_BASE_URL=https://aip.baidubce.com
# FINREPORT_OCR_API_KEY=your-baidu-api-key
# FINREPORT_OCR_SECRET_KEY=your-baidu-secret-key
# FINREPORT_OCR_MAX_RETRIES=2
# FINREPORT_OCR_TIMEOUT_SECONDS=120
# FINREPORT_OCR_POLL_INTERVAL_SECONDS=5
# FINREPORT_OCR_MAX_PAGE_BYTES=8388608
# Evidence retrieval: official mcp-server-qdrant 0.8.1, streamable-http.
# Start the isolated local service with tools/local-mcp/start-qdrant.ps1.
# It fixes FastEmbed BAAI/bge-small-zh-v1.5 and per-filing metadata filters.
# Model weights, service venvs and index data stay in ignored data/local-services.
# FINREPORT_QDRANT_ENABLED=true
# FINREPORT_QDRANT_MCP_URL=http://127.0.0.1:18768/mcp/
# FINREPORT_QDRANT_MCP_TOKEN=...
# FINREPORT_QDRANT_COLLECTION=finreport_document_chunks
# FINREPORT_QDRANT_TIMEOUT_SECONDS=120
# Optional native PDF text preprocessing (separate from strict financial facts).
# Start tools/local-mcp/start-docling.ps1; this service disables OCR and VLM.
# FINREPORT_DOCLING_ENABLED=true
# FINREPORT_DOCLING_MCP_URL=http://127.0.0.1:18769/mcp
# FINREPORT_DOCLING_MCP_TIMEOUT_SECONDS=300
# FINREPORT_DOCLING_ARTIFACT_DIR=data/local-services/mcp/docling-artifacts
# FINREPORT_DOCLING_MCP_CACHE_DIR=data/local-services/mcp/docling-output
# Optional direct Qdrant REST adapter uses reproducible lexical hash vectors;
# it is not the MCP backend and does not claim semantic embedding quality.
# FINREPORT_QDRANT_URL=http://127.0.0.1:6333
# FINREPORT_QDRANT_API_KEY=...
# FINREPORT_QDRANT_VECTOR_SIZE=256
# ClamAV virus-database update is opt-in and requires a local freshclam package.
# The API update button queues tools/update-clamav-database.ps1; it never replaces
# the active database until signatures and native probe pass.
FINREPORT_AV_UPDATE_ENABLED=false
# FINREPORT_AV_UPDATE_SCRIPT=./tools/update-clamav-database.ps1
# FINREPORT_AV_UPDATE_FRESHCLAM=./clamav-updater/freshclam.exe
# FINREPORT_AV_UPDATE_CONFIG=./clamav-updater/freshclam.conf
# FINREPORT_AV_UPDATE_SIGTOOL=./clamav-updater/sigtool.exe
# FINREPORT_AV_UPDATE_SIGNATURE_CERTS=./clamav-updater/certs
# FINREPORT_AV_UPDATE_PROBE_EXECUTABLE=./scanner/finreport-scanner-supervisor.exe
# FINREPORT_AV_UPDATE_PROBE_FILE=./tmp/clamav-official/eicar-standard.txt
FINREPORT_AV_UPDATE_TIMEOUT_SECONDS=900
